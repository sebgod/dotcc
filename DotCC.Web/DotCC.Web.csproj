<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <!-- The web sandbox is a consumer of DotCC.Lib, not a shipped package, and not
         part of the test chain (docs/plans/fable-web.md, D6). It opts out of the
         repo's Central Package Management so the Blazor deps carry their own
         versions without touching Directory.Packages.props. -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <IsPackable>false</IsPackable>
    <!-- A C compiler doesn't need culture data; dropping ICU trims the payload. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- The generated LALR parse tables are huge primitive-array literals; trimming
         must not touch DotCC.Lib (reflection over embedded resources + the tables). -->
    <TrimMode>partial</TrimMode>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.9" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.9" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DotCC.Lib\DotCC.Lib.csproj" />
  </ItemGroup>

  <!-- The Python page shows the programs CI runs on the dotcc-built CPython: their source
       and the output host CPython prints, which the interpreter has to reproduce. They are
       read from examples/cpython/programs, so the page and the tests cannot drift apart. -->
  <ItemGroup>
    <EmbeddedResource Include="..\examples\cpython\programs\*.py;..\examples\cpython\programs\*.expected"
                      LogicalName="python/%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Python in the tab (fable-web.md, WEB9): when the shared CPython build is there
       (examples/cpython/build.sh with BUILD_SHARED=1) and the packed standard library
       (examples/cpython/pack-stdlib.py, into wwwroot/cpython/stdlib.zip, git-ignored) are both
       there, the app carries libpython, loaded lazily on the Python page's first run, and the
       zip, which that run unpacks into the tab's file system. Without it the
       site builds as before and the page says Python does not run here. -->
  <PropertyGroup>
    <CPythonBuild Condition="'$(CPythonBuild)' == ''">$(MSBuildThisFileDirectory)..\examples\cpython\build\</CPythonBuild>
    <WithPython Condition="'$(WithPython)' == '' And Exists('$(CPythonBuild)shared\python3.13\python3.13.csproj') And Exists('$(MSBuildThisFileDirectory)wwwroot\cpython\stdlib.zip')">true</WithPython>
    <DefineConstants Condition="'$(WithPython)' == 'true'">$(DefineConstants);DOTCC_PYTHON</DefineConstants>
    <AllowUnsafeBlocks Condition="'$(WithPython)' == 'true'">true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup Condition="'$(WithPython)' == 'true'">
    <ProjectReference Include="$(CPythonBuild)shared\python3.13\python3.13.csproj" />
    <BlazorWebAssemblyLazyLoad Include="python3.13.wasm" />
  </ItemGroup>

  <!-- Keep DotCC.Lib whole: the parse tables + embedded system headers are reached
       structurally / via manifest resources, which the trimmer can't see. -->
  <ItemGroup>
    <TrimmerRootAssembly Include="DotCC.Lib" />
  </ItemGroup>

</Project>
