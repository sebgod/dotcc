@page "/python"

<PageTitle>dotcc: CPython 3.13 on .NET</PageTitle>
#if DOTCC_PYTHON
@inject DotCC.Web.Python.PythonRuntime Py
#endif

<section class="cov-head">
    <h1><span class="hl-py">CPython 3.13</span>, compiled by dotcc, on <span class="hl-net">.NET</span></h1>
    <p class="lede">
        This is not a Python reimplementation. It is <strong>the real CPython interpreter</strong>:
        its C sources compiled to C# by dotcc and linked into one .NET program. The programs below
        run on it with the same output host CPython prints, and CI checks that on every pull
        request and every night.
    </p>
    <div class="cta-row">
        <a class="cta" href="https://github.com/sebgod/dotcc/tree/main/examples/cpython" target="_blank" rel="noopener">Build it yourself ↗</a>
        <a class="cta" href="https://github.com/sebgod/dotcc/blob/main/.github/workflows/python.yml" target="_blank" rel="noopener">The CI workflow ↗</a>
        <a class="cta ghost" href="https://github.com/sebgod/dotcc/milestone/2" target="_blank" rel="noopener">The milestone ↗</a>
    </div>
</section>

<div class="cov-grid">
    <section class="cov-panel">
        <h2><span class="card-tag py">Static</span> One program</h2>
        <ul class="cov-list">
            <li><b>The interpreter</b>: 178 of CPython 3.13's translation units (the parser, the object model, the eval loop, the import system and the bootstrap modules), each compiled to an object with <code>dotcc --emit=obj</code> and linked into one C# program.</li>
            <li><b>Startup</b>: the frozen modules are generated by a host Python of the same minor version, as CPython's own build does. The standard library is CPython's <code>Lib/</code>, unchanged.</li>
            <li><b>Paths</b>: the build is configured as a POSIX CPython, so on Windows it is linked with <code>-fposix-paths</code> and sees <code>/c/Users/...</code> where the host has <code>C:\Users\...</code>.</li>
            <li><b>NativeAOT</b>: the same program publishes as a NativeAOT executable, which starts in under 0.1 s. The JIT build takes about 2 s, most of it compiling the interpreter's startup path.</li>
        </ul>
    </section>

    <section class="cov-panel">
        <h2><span class="card-tag py">Shared</span> libpython and extension modules</h2>
        <ul class="cov-list">
            <li><b>libpython</b> is a managed library (<code>dotcc -shared -fassembly</code>), and <code>python</code> is a thin program linked against it, as in CPython's shared build.</li>
            <li><b>An extension module</b> is an assembly of its own, linked against libpython: <code>_heapq</code> is built that way and installed as <code>_heapq.cpython-313-x86_64-linux-gnu.so</code>.</li>
            <li><b>Importing it</b> goes through CPython's own <code>dynload_shlib.c</code>: <code>dlopen</code> in dotcc's runtime loads the assembly, and it shares libpython's runtime, heap and globals with the interpreter. <code>heapq</code> then picks up the C accelerator, as it does on host CPython.</li>
            <li><b>NativeAOT</b> cannot load an assembly at run time, so that build keeps to the static link.</li>
        </ul>
    </section>
</div>

#if DOTCC_PYTHON
<section class="cov-note py-run">
    <h2>Run it in this tab</h2>
    <p>
        The interpreter below is the same dotcc-built CPython, as a .NET assembly running on
        the WebAssembly .NET runtime in this browser. The first run downloads it
        (libpython, then the standard library, unpacked into the tab's memory) and the runs
        after that start at once. Nothing leaves the tab.
    </p>
    <textarea class="py-source" spellcheck="false" @bind="_source" @bind:event="oninput" rows="12"></textarea>
    <div class="controls">
        <button class="run" @onclick="RunAsync" disabled="@_busy">@(_busy ? "Running…" : "▶ Run")</button>
        <span class="hint">@_hint</span>
    </div>
    @if (_result is { } r)
    {
        <pre class="stdout">@r.Stdout</pre>
        @if (r.Stderr.Length > 0)
        {
            <div class="stream-label">stderr</div>
            <pre class="stderr">@r.Stderr</pre>
        }
        <div class="exit @(r.ExitCode == 0 ? "ok" : "nonzero")">exit code: @r.ExitCode, @r.Elapsed.TotalSeconds.ToString("0.00") s</div>
    }
</section>
#endif

<section class="cov-note">
    <h2>The programs CI runs</h2>
    <p>
        Each program's output below is what host CPython 3.13 prints, and CI requires the
        dotcc-built interpreter to print exactly the same, on the static and the shared build.
        They are read from
        <a href="https://github.com/sebgod/dotcc/tree/main/examples/cpython/programs" target="_blank" rel="noopener">examples/cpython/programs</a>
        when this site is built, so this page shows what the tests check.
    </p>
    <div class="py-programs">
        @foreach (var p in _programs)
        {
            <article class="py-program">
                <h3><code>@(p.Name).py</code></h3>
                @foreach (var para in p.Summary)
                {
                    <p>@para</p>
                }
                <details>
                    <summary>Source (@p.SourceLines lines)</summary>
                    <pre class="code">@p.Source</pre>
                </details>
#if DOTCC_PYTHON
                <button class="run small" @onclick="() => RunProgramAsync(p)" disabled="@_busy">▶ Run here</button>
#endif
                <details>
                    <summary>Output</summary>
                    <pre class="stdout">@p.Output</pre>
                </details>
            </article>
        }
    </div>
</section>

<section class="cov-note">
    <h2>Not there yet</h2>
    <p>
        The interpreter runs pure-Python programs; the milestone's goal is an astropy program,
        and the gaps on the way are tracked as issues. Today the build has no threads (CPython's
        pthread stubs), and the modules <code>math</code>, <code>_struct</code>,
        <code>array</code>, <code>unicodedata</code> and <code>_opcode</code> are not built yet,
        so <code>random</code>, <code>datetime</code> and <code>dataclasses</code> do not import.
        Compute-heavy programs run several times slower than on host CPython.
    </p>
#if !DOTCC_PYTHON
    <p class="cov-outscope">
        This build of the site does not carry the interpreter, so Python does not run in this
        tab: the <a href="sandbox">sandbox</a> compiles C and Zig to WebAssembly.
    </p>
#endif
</section>

@code {
    /// <summary>One of the programs CI runs on the dotcc-built interpreter.</summary>
    /// <param name="Name">The file name without <c>.py</c>.</param>
    /// <param name="Summary">The paragraphs of its docstring.</param>
    /// <param name="Source">Its source.</param>
    /// <param name="Output">What host CPython 3.13 prints for it.</param>
    private sealed record PyProgram(string Name, IReadOnlyList<string> Summary, string Source, string Output)
    {
        /// <summary>The number of lines in <see cref="Source"/>.</summary>
        public int SourceLines => Source.TrimEnd('\n').Split('\n').Length;
    }

    /// <summary>The order the page shows them in: the tour of the language first, the
    /// benchmarks last. A program not listed here follows, by name.</summary>
    private static readonly string[] Order =
    {
        "features", "lisp", "objects", "tracebacks", "text_and_files", "paths",
        "richards", "fannkuch", "nbody", "spectral_norm",
    };

    private IReadOnlyList<PyProgram> _programs = Array.Empty<PyProgram>();

#if DOTCC_PYTHON
    private string _source = "import sys\nprint('Hello from', sys.implementation.name, sys.version.split()[0])\nprint(sum(i * i for i in range(10)))\n";
    private bool _busy;
    private string _hint = "";
    private DotCC.Web.Python.PythonRuntime.Result? _result;

    /// <summary>Run a program from the list: it goes into the box, so it can be edited and run again.</summary>
    private async Task RunProgramAsync(PyProgram p)
    {
        _source = p.Source;
        await RunAsync();
    }

    private async Task RunAsync()
    {
        if (_busy) { return; }
        _busy = true;
        _result = null;
        _hint = Py.IsLoaded ? "" : "Loading the interpreter and the standard library…";
        StateHasChanged();
        // Let the browser paint the busy state: the run itself holds the tab's only thread.
        await Task.Delay(30);
        try
        {
            if (!Py.IsLoaded)
            {
                var load = System.Diagnostics.Stopwatch.StartNew();
                await Py.EnsureLoadedAsync();
                _hint = $"Loaded in {load.Elapsed.TotalSeconds:0.0} s. Running…";
                StateHasChanged();
                await Task.Delay(30);
            }
            _result = await Py.RunAsync(_source);
            _hint = "";
        }
        catch (Exception ex)
        {
            _hint = $"Could not run: {ex.GetType().Name}: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }
#endif

    /// <summary>Read the programs from the resources the build embeds from
    /// <c>examples/cpython/programs</c> (see the project file).</summary>
    protected override void OnInitialized()
    {
        const string prefix = "python/";
        var asm = typeof(Python).Assembly;
        _programs = asm.GetManifestResourceNames()
            .Where(n => n.StartsWith(prefix, StringComparison.Ordinal) && n.EndsWith(".py", StringComparison.Ordinal))
            .Select(n => n[prefix.Length..^".py".Length])
            .OrderBy(n => Array.IndexOf(Order, n) is var i && i >= 0 ? i : int.MaxValue)
            .ThenBy(n => n, StringComparer.Ordinal)
            .Select(n =>
            {
                var source = Read(asm, $"{prefix}{n}.py");
                return new PyProgram(n, Docstring(source), source, Read(asm, $"{prefix}{n}.expected"));
            })
            .ToList();
    }

    /// <summary>An embedded text resource, with Windows line ends made plain.</summary>
    private static string Read(System.Reflection.Assembly asm, string name)
    {
        using var stream = asm.GetManifestResourceStream(name);
        if (stream is null) { return ""; }
        using var reader = new StreamReader(stream);
        return reader.ReadToEnd().Replace("\r", "");
    }

    /// <summary>The paragraphs of the module docstring that opens <paramref name="source"/>,
    /// each on one line, with a docstring's escaped backslash read as one.</summary>
    private static IReadOnlyList<string> Docstring(string source)
    {
        const string quotes = "\"\"\"";
        if (!source.StartsWith(quotes, StringComparison.Ordinal)) { return Array.Empty<string>(); }
        var end = source.IndexOf(quotes, quotes.Length, StringComparison.Ordinal);
        if (end < 0) { return Array.Empty<string>(); }
        return source[quotes.Length..end]
            .Split("\n\n")
            .Select(p => string.Join(' ', p.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)).Replace(@"\\", @"\"))
            .Where(p => p.Length > 0)
            .ToList();
    }
}
